# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
# Fixed test tokens (dev-admin-token / dev-employee-token) only when NODE_ENV=development AND this is true
ALLOW_DEV_TOKENS=false
# Express 'trust proxy' (false, true, a hop count such as 1, or a subnet); used for client IPs in rate limiting
TRUST_PROXY=false

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_KEY_PREFIX=wp:
REDIS_CONNECT_TIMEOUT_MS=10000
REDIS_MAX_RECONNECT_ATTEMPTS=10

# Supabase credentials. The server key is required to verify users' roles (from profiles/roles, never
# from user_metadata) and to persist GPS history; without it every bearer token is treated as unauthenticated.
# The anon key is NOT used as a fallback.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Caching Defaults
CACHE_DEFAULT_TTL_SECONDS=300
PAYROLL_CACHE_TTL_SECONDS=600

# Rate Limiting Defaults
RATE_LIMIT_PUNCH_WINDOW_SECONDS=60
RATE_LIMIT_PUNCH_MAX=5
RATE_LIMIT_API_WINDOW_SECONDS=60
RATE_LIMIT_API_MAX=100

# Geospatial Buffer
GEO_BUFFER_FLUSH_INTERVAL_SECONDS=15
